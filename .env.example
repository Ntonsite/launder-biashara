# Copy to .env. Never commit .env.
APP_ENV=development
# PostgreSQL + PostGIS only: `docker compose up -d postgres redis` publishes both on localhost.
# docker-compose overrides DATABASE_URL and REDIS_URL inside the api container.
DATABASE_URL=postgresql+psycopg://launder:launder_dev@localhost:5432/launder
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
TIMEZONE=Africa/Dar_es_Salaam
CORS_ORIGINS_CSV=http://localhost:5173,http://127.0.0.1:5173
# Development conveniences. Both MUST be false in production (the API refuses to start otherwise).
AUTO_SEED=true
EXPOSE_DEV_OTP=true
PAYMENT_WEBHOOK_SECRET=replace-me
POSTGRES_PASSWORD=launder_dev
