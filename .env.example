# Copy to .env. Never commit .env.
APP_ENV=development
# docker-compose overrides DATABASE_URL and REDIS_URL for the containers.
DATABASE_URL=sqlite:///./launder_dev.db
REDIS_URL=
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
TIMEZONE=Africa/Dar_es_Salaam
CORS_ORIGINS_CSV=http://localhost:5173,http://127.0.0.1:5173
# Development conveniences. Both MUST be false in production (the API refuses to start otherwise).
AUTO_SEED=true
EXPOSE_DEV_OTP=true
PAYMENT_WEBHOOK_SECRET=replace-me
POSTGRES_PASSWORD=launder_dev
